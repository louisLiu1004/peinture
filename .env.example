# ================================================
# Peinture AI - Docker Deployment Configuration
# ================================================
# All sensitive credentials are stored on the backend only.
# Users can still manually configure in Settings UI for local usage.

# ================================================
# AI Service Tokens (Backend Proxy)
# ================================================

# HuggingFace Token (supports multiple tokens separated by comma)
HF_TOKEN=

# Gitee AI Token
GITEE_TOKEN=

# ModelScope Token
MS_TOKEN=

# OpenRouter API
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# OpenAI Compatible API (Azure OpenAI, Ollama, etc.)
OPENAI_COMPAT_API_URL=
OPENAI_COMPAT_API_KEY=

# ================================================
# Storage Configuration (Backend Proxy)
# ================================================

# Storage Type: off | s3 | webdav
STORAGE_TYPE=off

# S3 Storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_ENDPOINT=
S3_BUCKET=
S3_PUBLIC_DOMAIN=
S3_PREFIX=peinture/

# WebDAV Storage
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=
WEBDAV_DIRECTORY=peinture
