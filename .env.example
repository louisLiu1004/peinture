# --- Service Mode ---
# Options: local | server | hydration
VITE_SERVICE_MODE=local

# --- API Tokens (Optional for static deployment) ---
# For static deployments (Vercel, Cloudflare Pages), these are embedded in the build.
# For Docker deployment with proxy, leave these empty and use server-side variables below.

# Hugging Face Token (supports multiple tokens separated by comma)
VITE_HF_TOKEN=

# Gitee AI Token (supports multiple tokens separated by comma)
VITE_GITEE_TOKEN=

# ModelScope Token (supports multiple tokens separated by comma)
VITE_MS_TOKEN=

# --- Storage Configuration ---
# Options: s3, webdav, local (default)
VITE_STORAGE_TYPE=local

# S3 Storage Configuration (if STORAGE_TYPE=s3)
VITE_S3_ACCESS_KEY=
VITE_S3_SECRET_KEY=
VITE_S3_REGION=
VITE_S3_ENDPOINT=
VITE_S3_BUCKET=
VITE_S3_PUBLIC_DOMAIN=

# WebDAV Storage Configuration (if STORAGE_TYPE=webdav)
VITE_WEBDAV_URL=
VITE_WEBDAV_USER=
VITE_WEBDAV_PASSWORD=

# --- Default Model Configuration ---
# Format: provider:model_id
# Example: huggingface:openai-fast
VITE_DEFAULT_TEXT_MODEL=
VITE_DEFAULT_EDIT_MODEL=
VITE_DEFAULT_LIVE_MODEL=
VITE_DEFAULT_UPSCALE_MODEL=

# --- Server-side Tokens (Docker deployment only) ---
# These are injected by the backend proxy, not exposed to the frontend.

# OpenRouter API Configuration
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# HuggingFace (for future proxy support)
HF_TOKEN=

# Gitee AI (for future proxy support)
GITEE_TOKEN=

# ModelScope (for future proxy support)
MS_TOKEN=
